@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #52667B
skinparam classBackgroundColor #F0F7F6
skinparam classBorderColor #267568
skinparam componentBackgroundColor #F0F7F6
skinparam noteBackgroundColor #FFF4D9
skinparam noteBorderColor #D8AA49
skinparam roundcorner 10
skinparam nodesep 70
skinparam ranksep 85
title 多人共享记账系统 · 组件与分层架构
top to bottom direction
package "表现层" {
  component "账本 / 成员界面" as V1
  component "收支 / 审核 / 更正界面" as V2
  component "统计 / 预算 / 结算 / 日志界面" as V3
}
component "请求入口\n身份、账本归属、角色校验" as Auth
package "应用与领域层（同一应用内的逻辑模块）" {
  component "账本与成员服务" as M
  component "收支与审核服务" as E
  component "预算服务" as B
  component "查询统计服务" as Q
  component "结算服务" as S
  component "分摊 / 调整策略接口" as P
  component "日志与导出服务" as A
  component "事务与幂等协调" as T
}
component "数据访问层\n带账本范围、版本比较、唯一约束" as R
database "关系数据库\n业务表 / 快照 / 日志 / 请求凭据" as DB
V1 --> Auth
V2 --> Auth
V3 --> Auth
Auth --> M
Auth --> E
Auth --> Q
Auth --> B
Auth --> S
Auth --> A
E --> B : 已审及待审占用 / 超限仅提示
E --> P : 调整与承担关系校验
S --> P : 计算成员差额
Q --> R : 同口径有效明细与调整
M --> T
E --> T
B --> T
S --> T
T --> A : 同事务追加成功日志
T --> R : 业务与成功凭据整体提交
A --> R
B --> R
S --> R
R --> DB
note bottom of T
先授权，再判断幂等；旧版本拒绝覆盖。
结算以账本月份串行保护并使用数据库唯一约束兜底。
业务 / 快照 / 锁定关联 / 成功日志 / 请求凭据同事务。
提交时锁定账本成员配额，幂等重试不重复占位；待审最多5笔。
end note
note bottom of P
均摊余分提交时固化；跨月调整归提交当前月。
允许多次调整，统计仅累计已审核调整的有向效果。
这是模块化单体方案，不要求微服务或分布式部署。
end note
@enduml
