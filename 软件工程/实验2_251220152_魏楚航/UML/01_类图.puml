@startuml
!pragma layout smetana
skinparam defaultFontName Microsoft YaHei
skinparam backgroundColor #FFFFFF
skinparam shadowing false
skinparam ArrowColor #52667B
skinparam classBackgroundColor #F0F7F6
skinparam classBorderColor #267568
skinparam componentBackgroundColor #F0F7F6
skinparam noteBackgroundColor #FFF4D9
skinparam noteBorderColor #D8AA49
skinparam roundcorner 10
skinparam nodesep 70
skinparam ranksep 85
title 多人共享记账系统 · 领域类图（AI 设计初稿）
hide empty methods
class "用户" as User {
  +id: UUID
  +昵称: String
  -密码哈希: String
  -独立盐: String
}
class "账本" as Ledger {
  +id: UUID
  +名称: String
  +超预算阻止提交: Boolean
}
class "成员关系" as Member {
  +id: UUID
  +角色: Role
  +在册: Boolean
  +加入时间: DateTime
  +退出时间: DateTime [0..1]
}
enum Role {
  管理员
  普通记账成员
  只读成员
}
class "邀请" as Invite {
  +id: UUID
  +邀请码摘要: String
  +到期时间: DateTime
}
class "分类" as Category {
  +id: UUID
  +名称: String
  +收支类型: String
}
class "收支记录" as Entry {
  +id: UUID
  +类型: 收入或支出
  +金额分: Long
  +发生时间: DateTime
  +备注: String
  +主状态: EntryState
  +版本: Integer
  +已更正: Boolean
  +创建请求号: UUID
}
enum EntryState {
  待审核
  已驳回
  已撤回
  已审核
  已作废
}
class "分摊明细" as Share {
  +id: UUID
  +承担金额分: Long
}
class "调整信息" as Adjustment {
  +方向: 补记或冲减
  +原因: String
  +归属月份: YearMonth
}
class "月预算" as Budget {
  +id: UUID
  +月份: YearMonth
  +限额分: Long
  +版本: Integer
}
class "结算单" as Settlement {
  +id: UUID
  +月份: YearMonth
  +状态: 有效或已作废
  +生成时间: DateTime
  +作废原因: String [0..1]
}
class "记录快照" as Snapshot {
  +原记录版本: Integer
  +金额及分摊快照: JSON
}
class "成员差额快照" as Balance {
  +实付分: Long
  +承担分: Long
  +净差额分: Long
}
class "操作日志" as Audit {
  +id: UUID
  +时间: DateTime
  +动作: String
  +对象编号: UUID
  +结果: String
  +原因: String
}
class "请求凭据" as Request {
  +请求号: UUID
  +请求摘要: String
  +操作人编号: UUID
  +结果引用: UUID
}
User "1" -- "0..*" Member
Ledger "1" -- "1..*" Member
Ledger "1" -- "0..*" Invite
Invite "0..*" --> "1" Member : 生成者
Ledger "1" -- "0..*" Entry
Ledger "1" -- "0..*" Category
Entry "0..*" --> "1" Member : 创建人
Entry "0..*" --> "1" Member : 实际付款或收款人
Entry "0..*" --> "1" Category
Entry "1" *-- "1..*" Share
Share "0..*" --> "1" Member : 承担人
Entry "1" *-- "0..1" Adjustment : 本记录为调整时
Adjustment "0..*" --> "1" Entry : 原记录
Ledger "1" -- "0..*" Budget
Budget "0..*" --> "0..1" Category : 空表示月总预算
Ledger "1" -- "0..*" Settlement
Settlement "1" *-- "1..*" Snapshot
Snapshot "0..*" --> "1" Entry : 来源及版本
Settlement "1" *-- "1..*" Balance
Balance "0..*" --> "1" Member
Settlement "0..*" --> "0..1" Settlement : 前一张作废单
Ledger "1" -- "0..*" Audit
Audit "0..*" --> "1" User : 操作人
Ledger "1" -- "0..*" Request
note bottom of Member
同用户同账本仅一条有效成员关系；退出不删历史。
至少保留一名管理员；多管理员策略待确认。
end note
note bottom of Entry
五个主状态；已更正、结算锁定均非主状态。
常规金额 1..100000000 分；不使用浮点金额。
调整沿用收支记录，独立审核，原金额不覆盖。
end note
note bottom of Adjustment
AI设计假设：方向与正金额分开保存。
跨月、多次更正及分摊算法仍待确认。
end note
note bottom of Settlement
同账本同月至多一张有效单；旧快照不覆盖。
快照关联推导锁定；作废后的锁定策略待确认。
end note
note bottom of Request
同账本同请求号唯一；授权后才可返回原结果。
成功凭据、业务与日志同事务；保留期限待确认。
end note
@enduml
